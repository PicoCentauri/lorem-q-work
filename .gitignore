# Large source/intermediate data behind each dataset's clean train/val/test
# files and README.md. See each dataset's raw/<name>/README.md for how to
# regenerate it.
raw/

.venv/
__pycache__/

.DS_Store
.claude/settings.local.json
.vscode/* 

*.log

# Per-experiment generated artifacts: prepared marathon datasets (rebuild
# with each experiment's prepare.py) and training run outputs (checkpoints,
# logs -- rebuild by rerunning lorem-train). Configs (model.yaml,
# settings.yaml, prepare.py, README.md) stay tracked.
experiments/*/data/
experiments/*/*/run/
# glob, not the bare name: the cache gets renamed aside (evaluate_rows.json
# .pre-<round>) when a round is re-evaluated, and a suffix defeated the exact
# match once already -- it is 55 MB.
experiments/*/evaluate_rows.json*
# SLURM stdout, one per experiment dir and one at each folder's top level for
# the evaluate job. Same category as the run/ outputs above: regenerable, and
# the training logs run to hundreds of KB each.
experiments/*/slurm.out
experiments/*/*/slurm.out

# hpc-tools stuff
Makefile
*.mk
RUNS.md

# natcomm2025 ships as DeepMD .npy plus the archives it was extracted from and
# a 93 MB frozen TF model. Only the converted extxyz is tracked (via LFS);
# datasets/natcomm2025/convert.py regenerates it from these.
datasets/natcomm2025/data_set/
datasets/natcomm2025/*.tar.gz
datasets/natcomm2025/*.zip
datasets/natcomm2025/*.pb
datasets/natcomm2025/OH-strus/
datasets/natcomm2025/*.pdf

# The publication source drop: 850 MB of xyz + json that duplicates data we
# already have. razor_centre_paper_{train,test}.xyz plus their struc_pk lists
# are the tracked artefacts, and make_paper_split.py regenerates them from the
# lists alone once this folder is deleted.
datasets/razor/Publication_data_for_ploche/

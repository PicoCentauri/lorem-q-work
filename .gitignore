# Large source/intermediate data behind each dataset's clean train/val/test
# files and README.md. See each dataset's raw/<name>/README.md for how to
# regenerate it.
raw/

.venv/
__pycache__/

.DS_Store
.claude/settings.local.json
.vscode/* 

*.log

# Per-experiment generated artifacts: prepared marathon datasets (rebuild
# with each experiment's prepare.py) and training run outputs (checkpoints,
# logs -- rebuild by rerunning lorem-train). Configs (model.yaml,
# settings.yaml, prepare.py, README.md) stay tracked.
experiments/*/data/
experiments/*/*/run/
experiments/*/evaluate_rows.json

# hpc-tools stuff
Makefile
*.mk
RUNS.md